sha256sums_aarch64=('3995425435d5e04031b4fb3c89aedde936e3bb5640da8a86bc325e8cb2ba9060')

package() {
  install -Dm755 books-tui "$pkgdir/usr/bin/books-tui"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
