pkgname=books-tui-bin
pkgver=0.1.2
pkgrel=1
pkgdesc="Browse, fuzzy-search, and open your PDF library from the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/Prakhil-tp/books-tui"
license=('MIT')
provides=('books-tui')
conflicts=('books-tui')
options=('!debug')
optdepends=('zathura-pdf-mupdf: default PDF reader'
            'poppler: author, page, and year metadata')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/Prakhil-tp/books-tui/v$pkgver/LICENSE")
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/books-tui-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/books-tui-aarch64-unknown-linux-musl.tar.gz")
sha256sums=('460c3bf8fd078d7020678dd3e310a088a1d97f1e0936aa926b369f0655888982')
